# Local DeltaX API; no credentials belong in this file.
DELTAX_API_URL=
# Executive mode: stub | DELTAX | local_runtime | disabled
# - stub: labeled stub only (CI/dev)
# - DELTAX: requires DELTAX_API_URL (canonical_api); fails loudly without it
# - local_runtime: requires DELTAX_LOCAL_RUNTIME_CMD; fails loudly without it
# - disabled: no executive
DELTAX_EXECUTIVE=stub
# Path or command for the shared private local JSONL provider (never commit real machine secrets).
# Example: /path/to/deltax-python-runtime/.venv/bin/python -m deltax_runtime.provider
DELTAX_LOCAL_RUNTIME_CMD=
